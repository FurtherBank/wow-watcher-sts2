<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.4</Version>
    <PathMap>$(MSBuildProjectDirectory)=/_/WowWatcher</PathMap>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <SteamApps Condition="'$(SteamApps)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamApps>
    <GameData Condition="'$(GameData)' == ''">$(SteamApps)/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</GameData>
    <Workshop Condition="'$(Workshop)' == ''">$(SteamApps)/workshop/content/2868840</Workshop>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" Private="false" />
    <Reference Include="BaseLib" HintPath="$(Workshop)/3737335127/BaseLib/BaseLib.dll" Private="false" />
    <Reference Include="Watcher" HintPath="$(Workshop)/3747492505/Watcher.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckBuildReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameData)/sts2.dll')" Text="Set GameData to the STS2 beta v0.113.0 directory containing sts2.dll (see README)." />
    <Error Condition="!Exists('$(Workshop)/3737335127/BaseLib/BaseLib.dll') Or !Exists('$(Workshop)/3747492505/Watcher.dll')" Text="Set Workshop to the STS2 Steam Workshop content directory, with BaseLib and The Watcher installed (see README)." />
  </Target>
</Project>
